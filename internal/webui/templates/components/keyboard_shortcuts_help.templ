package components

templ KeyboardShortcutsHelp() {
	<!-- Keyboard Shortcuts Cheat Sheet -->
	<div x-show="showShortcutsHelp"
		 x-cloak
		 x-transition:enter="ease-out duration-200"
		 x-transition:enter-start="opacity-0"
		 x-transition:enter-end="opacity-100"
		 x-transition:leave="ease-in duration-150"
		 x-transition:leave-start="opacity-100"
		 x-transition:leave-end="opacity-0"
		 class="fixed inset-0 z-[70] overflow-y-auto"
		 @click.away="showShortcutsHelp = false"
		 style="display: none;"
		 role="dialog"
		 aria-modal="true"
		 aria-labelledby="shortcuts-help-title">
		<div class="fixed inset-0 bg-gray-500/75 dark:bg-black/60 backdrop-blur-sm"></div>
		<div class="flex min-h-screen items-center justify-center p-4">
			<div class="relative bg-white dark:bg-dark-bg-secondary rounded-xl shadow-2xl max-w-lg w-full p-6">
				<div class="flex items-center justify-between mb-4">
					<h2 id="shortcuts-help-title" class="text-lg font-semibold text-gray-900 dark:text-white">Keyboard shortcuts</h2>
					<button @click="showShortcutsHelp = false" aria-label="Close"
							class="p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
						</svg>
					</button>
				</div>
				<dl class="space-y-2 text-sm">
					for _, s := range []struct{ key, desc string }{
						{"j / k", "Move the row cursor down / up"},
						{"Enter / o", "Open the alert detail modal"},
						{"x", "Toggle selection of the cursor row"},
						{"Shift+X", "Select / deselect every row on the page"},
						{"a", "Acknowledge — cursor row, or the selection if non-empty"},
						{"s", "Silence — cursor row, or the selection if non-empty"},
						{"c", "Open the detail modal on the Comments tab"},
						{"h", "Hide the cursor row"},
						{"Esc", "Clear selection, or close the top-most modal"},
						{"?", "Toggle this cheat sheet"},
					} {
						<div class="flex items-center justify-between gap-4">
							<dt class="text-gray-600 dark:text-gray-400">{ s.desc }</dt>
							<dd class="font-mono text-xs px-2 py-1 bg-gray-100 dark:bg-dark-bg-tertiary rounded text-gray-800 dark:text-gray-200 whitespace-nowrap">{ s.key }</dd>
						</div>
					}
				</dl>
				<p class="mt-4 text-xs text-gray-500 dark:text-gray-400">Row shortcuts apply to the List view; not available while grouped.</p>
			</div>
		</div>
	</div>
}
