package components

// PageNavigator renders a prominent navigation switcher between Dashboard, Silences, Statistics and Activity
// activePage should be "dashboard", "silences", "statistics" or "activity"
templ PageNavigator(activePage string) {
	<nav class="page-navigator flex items-center gap-2" aria-label="Main navigation" x-data="mentionsWatcher()">
		<div class="flex items-center bg-slate-100 dark:bg-slate-800/50 rounded-xl p-1 shadow-inner">
			<!-- Alerts/Dashboard Tab -->
			<a
				href="/dashboard"
				class={ "group relative flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200",
					templ.KV("bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm", activePage == "dashboard"),
					templ.KV("text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-slate-700/50", activePage != "dashboard") }
			>
				<!-- Bell Icon -->
				<svg class={ "w-4 h-4 transition-transform duration-200",
					templ.KV("text-blue-500", activePage == "dashboard"),
					templ.KV("group-hover:scale-110", activePage != "dashboard") }
					fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
				</svg>
				<span>Alerts</span>
				<!-- Active indicator dot -->
				if activePage == "dashboard" {
					<span class="absolute -top-1 -right-1 w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
				}
			</a>

			<!-- Silences Tab -->
			<a
				href="/silences"
				class={ "group relative flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200",
					templ.KV("bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm", activePage == "silences"),
					templ.KV("text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-slate-700/50", activePage != "silences") }
			>
				<!-- Muted Bell Icon -->
				<svg class={ "w-4 h-4 transition-transform duration-200",
					templ.KV("text-purple-500", activePage == "silences"),
					templ.KV("group-hover:scale-110", activePage != "silences") }
					fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9.143 17.082a24.248 24.248 0 0 0 3.844.148m-3.844-.148a23.856 23.856 0 0 1-5.455-1.31 8.964 8.964 0 0 0 2.3-5.542m3.155 6.852a3 3 0 0 0 5.667 1.97m1.965-2.277L21 21m-4.225-4.225a23.81 23.81 0 0 0 3.536-1.003A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6.53 6.53m10.245 10.245L6.53 6.53M3 3l3.53 3.53" />
				</svg>
				<span>Silences</span>
				<!-- Active indicator dot -->
				if activePage == "silences" {
					<span class="absolute -top-1 -right-1 w-2 h-2 bg-purple-500 rounded-full animate-pulse"></span>
				}
			</a>

			<!-- Statistics Tab -->
			<a
				href="/statistics"
				class={ "group relative flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200",
					templ.KV("bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm", activePage == "statistics"),
					templ.KV("text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-slate-700/50", activePage != "statistics") }
			>
				<!-- Chart Icon -->
				<svg class={ "w-4 h-4 transition-transform duration-200",
					templ.KV("text-emerald-500", activePage == "statistics"),
					templ.KV("group-hover:scale-110", activePage != "statistics") }
					fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
				</svg>
				<span>Statistics</span>
				<!-- Active indicator dot -->
				if activePage == "statistics" {
					<span class="absolute -top-1 -right-1 w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
				}
			</a>

			<!-- Activity Tab -->
			<a
				href="/activity"
				class={ "group relative flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200",
					templ.KV("bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm", activePage == "activity"),
					templ.KV("text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-slate-700/50", activePage != "activity") }
			>
				<!-- Clock/History Icon -->
				<svg class={ "w-4 h-4 transition-transform duration-200",
					templ.KV("text-amber-500", activePage == "activity"),
					templ.KV("group-hover:scale-110", activePage != "activity") }
					fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
				</svg>
				<span>Activity</span>
				<!-- Active indicator dot -->
				if activePage == "activity" {
					<span class="absolute -top-1 -right-1 w-2 h-2 bg-amber-500 rounded-full animate-pulse"></span>
				}
			</a>
		</div>

		<!-- Mentions indicator: comments that @-mention the current user, not yet seen -->
		<button
			@click="openMentions()"
			type="button"
			title="Comments mentioning you"
			class="relative inline-flex items-center p-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-slate-700/50 transition-colors"
		>
			<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 10-2.636 6.364M16.5 12V8.25"/>
			</svg>
			<span x-show="unseenCount > 0" x-cloak x-text="unseenCount > 99 ? '99+' : unseenCount"
				class="absolute -top-1 -right-1 inline-flex items-center justify-center min-w-[1.1rem] h-[1.1rem] px-1 rounded-full text-[10px] font-bold bg-red-500 text-white"></span>
		</button>
	</nav>

	<script>
		// Polls for unseen @mentions, shows a badge next to the Activity tab and raises the
		// browser notification for each new mention, on every page (this component is embedded
		// wherever PageNavigator is). Fetches its own current-user id via /api/v1/auth/profile
		// rather than threading one through every caller's page template - one extra cheap GET
		// per page load, in exchange for staying fully self-contained.
		//
		// Mention notifications are raised here rather than delegated to NotificationService:
		// that service is loaded by the dashboard page only, and even there it boots
		// asynchronously, so any hand-off is a race the first poll loses. Self-contained
		// delivery also makes the "mentions ignore severity and filter-preset scoping" rule
		// true by construction instead of by a bypass inside the alert pipeline.
		function mentionsWatcher() {
			return {
				unseenCount: 0,
				userId: null,
				timer: null,

				init() {
					this.start();
				},

				async start() {
					try {
						const response = await fetch('/api/v1/auth/profile', { credentials: 'include' });
						if (response.ok) {
							const result = await response.json();
							if (result.success && result.data?.user?.id) {
								this.userId = result.data.user.id;
							}
						}
					} catch (error) {
						console.error('Failed to load current user for mentions watcher:', error);
					}
					if (!this.userId) {
						return;
					}
					await this.poll();
					this.timer = setInterval(() => this.poll(), 30000);
				},

				seenKey() {
					return 'notificator_mention_seen_' + this.userId;
				},

				notifiedKey() {
					return 'notificator_mention_notified_' + this.userId;
				},

				async poll() {
					try {
						const response = await fetch('/api/v1/dashboard/activity?mentionsOnly=true&windowMinutes=10080', {
							credentials: 'include'
						});
						const result = await response.json();
						if (!response.ok || !result.success) {
							return;
						}
						const events = result.data.events || [];

						const seenAt = Number(localStorage.getItem(this.seenKey())) || 0;
						this.unseenCount = events.filter(e => new Date(e.createdAt).getTime() > seenAt).length;

						await this.notifyFresh(events);
					} catch (error) {
						console.error('Failed to poll mentions:', error);
					}
				},

				// The notified watermark is a delivery receipt, not a "we looked at this poll"
				// marker: it moves past a mention only once that mention has actually been
				// shown, or once we know the user asked not to be notified. Anything that
				// leaves delivery undecided (preferences unreachable) leaves the watermark
				// alone so the next poll retries, instead of consuming the mention silently.
				//
				// This component is instantiated once per open tab, and every instance reads
				// and writes the same localStorage watermark. Without coordination, two tabs
				// polling close together can both read the same stale watermark and both
				// notify for the same mention. navigator.locks scopes the read-decide-write
				// below to one tab at a time per user; browsers without the Web Locks API
				// fall back to running unlocked (the pre-existing, racy behavior).
				async notifyFresh(events) {
					if ('locks' in navigator) {
						await navigator.locks.request(this.notifiedKey(), () => this._notifyFresh(events));
					} else {
						await this._notifyFresh(events);
					}
				},

				async _notifyFresh(events) {
					const notifiedAt = Number(localStorage.getItem(this.notifiedKey()));
					// First poll in this browser, or a corrupted watermark: start at "now" so a
					// pre-existing backlog doesn't fire a burst of notifications.
					if (!Number.isFinite(notifiedAt) || notifiedAt <= 0) {
						localStorage.setItem(this.notifiedKey(), String(Date.now()));
						return;
					}

					const fresh = events.filter(e => new Date(e.createdAt).getTime() > notifiedAt);
					if (fresh.length === 0) {
						return;
					}

					const enabled = await this.notificationsEnabled();
					if (enabled === null) {
						return;
					}
					if (enabled) {
						fresh.forEach(e => this.showMention(e));
					}

					const maxCreated = fresh.reduce((max, e) => Math.max(max, new Date(e.createdAt).getTime()), notifiedAt);
					localStorage.setItem(this.notifiedKey(), String(maxCreated));
				},

				// true/false = the user does/doesn't want browser notifications, null = we
				// couldn't find out. Read at delivery time rather than cached at page load:
				// the preference can be flipped from the settings modal or another tab.
				// Severity and filter-preset scoping are deliberately not consulted - a mention
				// is a direct ask from a teammate, not a fired alert.
				async notificationsEnabled() {
					if (!('Notification' in window) || Notification.permission !== 'granted') {
						return false;
					}
					try {
						const response = await fetch('/api/v1/notifications/preferences', { credentials: 'include' });
						if (!response.ok) {
							return null;
						}
						const result = await response.json();
						if (!result.success || !result.data) {
							return null;
						}
						return result.data.browser_notifications_enabled === true;
					} catch (error) {
						console.error('Failed to read notification preferences for mentions:', error);
						return null;
					}
				},

				showMention(event) {
					try {
						const notification = new Notification('You were mentioned', {
							body: (event.content || '').slice(0, 200),
							icon: '/static/images/info-icon.png',
							tag: 'mention-' + event.id
						});

						notification.onclick = () => {
							window.focus();
							if (window.location.pathname.startsWith('/dashboard') && window.dashboardInstance?.showAlertDetails) {
								window.dashboardInstance.showAlertDetails(event.alertKey);
							} else {
								window.location.href = '/dashboard/alert/' + event.alertKey;
							}
							notification.close();
						};
					} catch (error) {
						console.error('Failed to show mention notification:', error);
					}
				},

				openMentions() {
					if (this.userId) {
						localStorage.setItem(this.seenKey(), String(Date.now()));
					}
					this.unseenCount = 0;
					window.location.href = '/activity?mentions=1';
				}
			};
		}
	</script>
}
