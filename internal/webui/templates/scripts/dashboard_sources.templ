package scripts

templ DashboardSourcesMixin() {
	<script>
		window.dashboardSourcesMixin = {
			// State (will be merged into dashboard)
			// name -> {state, lastSuccessAt, lastError, consecutiveFailures, alertCount}
			sources: {},
			sourcesPopoverOpen: false,
			// name -> dismissed-at (ms); cleared once the source is live again so the
			// banner reappears if it goes bad a second time.
			dismissedStaleSources: {},

			// Applied from the initial dashboard payload and every SSE/poll update.
			applySourcesUpdate(sources) {
				if (!sources) return;
				this.sources = sources;

				Object.keys(this.dismissedStaleSources).forEach(name => {
					const src = sources[name];
					if (!src || src.state === 'live') {
						delete this.dismissedStaleSources[name];
					}
				});
			},

			sourceEntries() {
				return Object.entries(this.sources || {}).map(([name, status]) => ({ name, ...status }));
			},

			sourcesSummary() {
				const entries = this.sourceEntries();
				return {
					live: entries.filter(s => s.state === 'live').length,
					total: entries.length
				};
			},

			sourcesPillColorClasses() {
				const { live, total } = this.sourcesSummary();
				if (total === 0 || live === total) {
					return 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-200';
				}
				if (live === 0) {
					return 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-200';
				}
				return 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200';
			},

			// Sources whose alerts may be stale, excluding ones the user dismissed
			// this session (until they recover and go bad again).
			staleSourceAlerts() {
				return this.sourceEntries().filter(s =>
					(s.state === 'stale' || s.state === 'unreachable') && !this.dismissedStaleSources[s.name]
				);
			},

			dismissStaleSourceBanner(name) {
				this.dismissedStaleSources[name] = Date.now();
			},

			sourceRelativeTime(iso) {
				if (!iso) return 'never';
				const seconds = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 1000));
				if (seconds < 5) return 'just now';
				if (seconds < 60) return `${seconds}s ago`;
				const minutes = Math.floor(seconds / 60);
				if (minutes < 60) return `${minutes}m ago`;
				const hours = Math.floor(minutes / 60);
				if (hours < 24) return `${hours}h ago`;
				const days = Math.floor(hours / 24);
				return `${days}d ago`;
			},

			toggleSourcesPopover() {
				this.sourcesPopoverOpen = !this.sourcesPopoverOpen;
			}
		};
	</script>
}
