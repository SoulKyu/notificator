package scripts

templ DashboardKeyboardMixin() {
	<script>
		window.dashboardKeyboardMixin = {
			cursorFingerprint: null,
			showShortcutsHelp: false,

			// Every dashboard modal that should swallow shortcuts, in one place so
			// focusSearch() and handleDashboardKeydown() can't drift apart.
			modalOpen() {
				return this.showSettings || this.showAckModal || this.showSilenceModal ||
					this.showAlertModal || this.showFilterPresetsModal ||
					this.showColumnConfigModal || this.showShortcutsHelp;
			},

			isTypingTarget(target) {
				return !!(target && target.closest && target.closest('input, textarea, select, [contenteditable]'));
			},

			// A focused button/link/etc. already activates on Enter/Space natively;
			// letting a global shortcut also fire for the same keypress double-fires
			// (e.g. Enter on a row's own action button opens that action's modal AND
			// the shortcut's own target).
			isActivatableTarget(target) {
				return !!(target && target.closest && target.closest('button, a, summary, [role="button"]'));
			},

			// Shared guard: no modal open, no Ctrl/Cmd/Alt modifier (so we don't
			// hijack browser/OS shortcuts), and focus isn't inside a text input or
			// on a keyboard-activatable control.
			shortcutsActive(event) {
				if (this.modalOpen()) return false;
				if (event && (event.ctrlKey || event.metaKey || event.altKey)) return false;
				if (event && this.isTypingTarget(event.target)) return false;
				if (event && this.isActivatableTarget(event.target)) return false;
				return true;
			},

			cursorAlertIndex() {
				return this.alerts.findIndex(a => a.fingerprint === this.cursorFingerprint);
			},

			cursorAlert() {
				const idx = this.cursorAlertIndex();
				return idx === -1 ? null : this.alerts[idx];
			},

			// Called after every full reload/incremental merge so the cursor stays
			// on its row when still present, and resets to the first row otherwise.
			normalizeCursor() {
				if (this.viewMode !== 'list' || this.alerts.length === 0) {
					this.cursorFingerprint = null;
					return;
				}
				if (this.cursorAlertIndex() === -1) {
					this.cursorFingerprint = this.alerts[0].fingerprint;
				}
			},

			moveCursor(delta) {
				if (!this.requireListView() || this.alerts.length === 0) return;
				const current = this.cursorAlertIndex();
				const idx = current === -1 ? 0 : Math.min(Math.max(current + delta, 0), this.alerts.length - 1);
				this.cursorFingerprint = this.alerts[idx].fingerprint;
				this.$nextTick(() => {
					document.querySelector('[data-alert-cursor="true"]')?.scrollIntoView({ block: 'nearest' });
				});
			},

			// Row-scoped shortcuts (cursor, selection toggle, ack/silence/hide) only
			// make sense against rendered rows, which the grouped view doesn't have.
			// The Resolved tab hides that table entirely without reloading/renormalizing
			// this.alerts, so it'd otherwise act on stale, invisible rows.
			requireListView() {
				if (this.viewMode === 'group') {
					this.showActionError('Row shortcuts are only available in List view — switch views to use them', true);
					return false;
				}
				if (this.displayMode === 'resolved') {
					this.showActionError('Row shortcuts are not available on the Resolved tab', true);
					return false;
				}
				return true;
			},

			toggleCursorSelection() {
				if (!this.requireListView()) return;
				const alert = this.cursorAlert();
				if (!alert) return;
				this.toggleAlert(alert.fingerprint);
			},

			toggleSelectAllRows() {
				if (!this.requireListView()) return;
				// A raw length comparison isn't a subset check: a full reload can replace
				// this.alerts with a different set of the same size without pruning
				// selectedAlerts, making stale counts look "already fully selected".
				const allSelected = this.alerts.length > 0 &&
					this.alerts.every(a => this.selectedAlerts.includes(a.fingerprint));
				if (allSelected) {
					this.clearSelection();
				} else {
					this.selectAll();
				}
			},

			openCursorDetails() {
				if (!this.requireListView()) return;
				const alert = this.cursorAlert();
				if (!alert) return;
				this.showAlertDetails(alert.fingerprint);
			},

			async openCursorComments() {
				if (!this.requireListView()) return;
				const alert = this.cursorAlert();
				if (!alert) return;
				await this.showAlertDetails(alert.fingerprint);
				this.currentAlertTab = 'comments';
				this.$nextTick(() => this.$refs.commentInput?.focus());
			},

			acknowledgeCursorOrSelection() {
				if (!this.requireListView()) return;
				if (this.selectedAlerts.length > 0 || this.selectedGroups.length > 0) {
					this.acknowledgeSelected();
					return;
				}
				const alert = this.cursorAlert();
				if (!alert) return;
				this.acknowledgeAlert(alert.fingerprint);
			},

			silenceCursorOrSelection() {
				if (!this.requireListView()) return;
				if (this.selectedAlerts.length > 0 || this.selectedGroups.length > 0) {
					this.silenceSelected();
					return;
				}
				const alert = this.cursorAlert();
				if (!alert) return;
				this.silenceAlert(alert.fingerprint);
			},

			// Hides exactly the cursor row via the existing bulk-hide path, without
			// disturbing a pre-existing checkbox selection.
			async hideCursorRow() {
				if (!this.requireListView()) return;
				// OS key-repeat fires keydown every 20-50ms, well inside a hideSelected()
				// fetch round-trip — without this guard, a held 'h' races two calls over
				// the same shared selectedAlerts/selectedGroups state.
				if (this._hidingCursorRow) return;
				const alert = this.cursorAlert();
				if (!alert) return;
				this._hidingCursorRow = true;
				try {
					const savedAlerts = this.selectedAlerts.slice();
					const savedGroups = this.selectedGroups.slice();
					this.selectedAlerts = [alert.fingerprint];
					this.selectedGroups = [];
					await this.hideSelected();
					// hideSelected() only clears selectedAlerts on full success; on a
					// rejected or failed hide it leaves the cursor's fingerprint there.
					// Restore the saved selection unconditionally: drop the cursor's
					// fingerprint if the hide succeeded, otherwise leave the saved
					// selection untouched (don't add the cursor row if it was never
					// part of it to begin with).
					const hideFailed = this.selectedAlerts.includes(alert.fingerprint);
					this.selectedAlerts = hideFailed ? savedAlerts : savedAlerts.filter(fp => fp !== alert.fingerprint);
					this.selectedGroups = savedGroups;
				} finally {
					this._hidingCursorRow = false;
				}
			},

			handleDashboardKeydown(event) {
				if (event.key === 'Escape') {
					if (this.showShortcutsHelp) {
						this.showShortcutsHelp = false;
						return;
					}
					// A dashboard modal is open — let its own Escape handler close it
					// instead of also clearing the selection underneath it.
					if (this.showSettings || this.showAckModal || this.showSilenceModal ||
						this.showAlertModal || this.showFilterPresetsModal || this.showColumnConfigModal) {
						return;
					}
					// Escape on a text field (e.g. the search box) should not clear the
					// alert selection as a side effect of blurring/clearing that field.
					if (this.isTypingTarget(event.target)) return;
					if (this.selectedAlerts.length > 0 || this.selectedGroups.length > 0) {
						this.clearSelection();
					}
					return;
				}

				if (event.key === '?') {
					if (event.ctrlKey || event.metaKey || event.altKey) return;
					if (this.isTypingTarget(event.target)) return;
					if (this.isActivatableTarget(event.target)) return;
					// Don't let the sheet's own open state block its own toggle — only
					// bail if some *other* modal is open.
					if (this.modalOpen() && !this.showShortcutsHelp) return;
					event.preventDefault();
					this.showShortcutsHelp = !this.showShortcutsHelp;
					return;
				}

				if (!this.shortcutsActive(event)) return;

				switch (event.key) {
					case 'j':
						event.preventDefault();
						this.moveCursor(1);
						break;
					case 'k':
						event.preventDefault();
						this.moveCursor(-1);
						break;
					case 'Enter':
					case 'o':
						this.openCursorDetails();
						break;
					case 'x':
					case 'X':
						if (event.shiftKey) {
							this.toggleSelectAllRows();
						} else {
							this.toggleCursorSelection();
						}
						break;
					case 'a':
						this.acknowledgeCursorOrSelection();
						break;
					case 's':
						this.silenceCursorOrSelection();
						break;
					case 'c':
						this.openCursorComments();
						break;
					case 'h':
						this.hideCursorRow();
						break;
				}
			}
		};
	</script>
}
